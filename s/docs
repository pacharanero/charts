#!/usr/bin/env bash
# Serve the Zensical chart site locally with hot reload and open it in a browser.
# Run `pip install -r requirements.txt` first if Zensical is not installed.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ -x .venv/bin/zensical ]]; then
  ZENSICAL=.venv/bin/zensical
elif command -v zensical >/dev/null 2>&1; then
  ZENSICAL=zensical
else
  cat >&2 <<'EOF'
zensical is not installed. Install it once from the repository root:

  python3 -m venv .venv
  ./.venv/bin/pip install -r requirements.txt

then re-run s/docs.
EOF
  exit 1
fi

exec "$ZENSICAL" serve --open "$@"
